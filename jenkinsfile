pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages{

        stage('Checkout'){
            steps{
                git 'https://github.com/kartikkorde7/student-management.git'
                echo "Clonning is Successful"
            }
        }

        stage('Build') {
            steps {
                sh '''
                  mvn clean package
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to s3') {
    steps {
        sh 'aws s3 cp target/*.war s3://devopsbykartik.fun/student.war'
            }
       }

        stage('SonarQube Analysis'){
            steps {
                withSonarQubeEnv('sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t student .
                    docker images
                '''
            }
        }

        stage('push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 533328365829.dkr.ecr.ap-south-1.amazonaws.com
                    docker tag student:latest 533328365829.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                    docker push 533328365829.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                '''
            }
        }
    }
}
