pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages{

        stage('Checkout'){
            steps{
                git 'https://github.com/kartikkorde7/student-management.git'
                echo "Clonning is Successful"
            }
        }

        stage('Build') {
            steps {
                sh '''
                  mvn clean package
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to s3') {
    steps {
        sh '''
            echo "Checking WAR file..."
            ls -lh target/*.war

            echo "Checking AWS..."
            aws --version
            aws sts get-caller-identity

            echo "Uploading WAR to S3..."
            aws s3 cp target/*.war s3://devopsbykartik.fun/student.war
        '''
            }
       }

        stage('SonarQube Analysis'){
            steps {
                withSonarQubeEnv('sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t student .
                    docker images
                '''
            }
        }
    }
}
