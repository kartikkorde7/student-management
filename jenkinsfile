pipeline {
    agent {
        label "worker"
    }
    tools {
        maven 'mvn'
    }

    stages {
        
        stage('checkout') {
            steps {
                git 'https://github.com/kartikkorde7/student-management.git'
                echo "clonning is done"                                 
            }
        }

            stage('Build') {
            steps {
                sh '''
                    mvn clean package
                    '''
            }
        }

        stage('Test') {
            steps {
                echo "testing is done"
            }
        }

        stage('Deploy') {
            steps {
                echo "deploying is done"
            }
        }
    }
}