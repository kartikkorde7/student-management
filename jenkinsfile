pipeline {
    agent {
        label 'worker'
    }
    tools {
        maven 'maven'
    }
    environment {
        aws_creds = credentials('aws-cred')
    }
    stages {
        stage('checkout') {
            steps {
                git 'https://github.com/kartikkorde7/student-management.git'
            }
        }
        stage('maven-build') {
            steps {
                sh '''
                mvn clean package
                sudo snap install aws-cli --classic
                '''
            }
        }
        stage('artifact-to-s3') {
            steps {
                    sh 'aws s3 cp target/*.war s3://devopsbykartik.fun/artifact/student.war'
                }
            }
        }
    }
